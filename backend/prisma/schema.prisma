// Prisma Schema for Plataforma Inteligente de Apoyo Académico COCID
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AcademicLevel {
  UNDERGRADUATE
  MASTER
  DOCTORATE
  ALL
}

enum ChangeRequestType {
  PROFILE_UPDATE
  PASSWORD_CHANGE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  NEW_CHANGE_REQUEST
  SYSTEM_ALERT
}

model User {
  id                 String              @id @default(uuid())
  externalId         String?             @unique
  nombre             String
  apellido           String
  email              String              @unique
  password_hash      String
  rol                Role                @default(STUDENT)
  activo             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  similarityReports  SimilarityReport[]
  lsmSessions        LsmSession[]
  studentProfile     StudentProfile?
  recommendations    Recommendation[]
  profile            UserProfile?
  changeRequests     ChangeRequest[]     @relation("UserChangeRequests")
  reviewedRequests   ChangeRequest[]     @relation("AdminReviewedRequests")
  notifications      Notification[]
  auditLogsActed     AuditLog[]          @relation("AuditLogsActed")
  auditLogsTargeted  AuditLog[]          @relation("AuditLogsTargeted")

  @@map("users")
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  apellidoMaterno String?
  telefono        String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ==========================================
// MÓDULO 1: SIMILITUD ACADÉMICA
// ==========================================
model SimilarityReport {
  id                 String         @id @default(uuid())
  documentTitle      String
  filename           String?
  fileUrl            String?
  fileSize           Int            @default(0)
  fileType           String?
  totalPages         Int            @default(1)
  totalWords         Int            @default(0)
  overallScore       Float          @default(0.0)
  aiProbability      Float          @default(0.0)
  sourcesCount       Int            @default(0)
  status             AnalysisStatus @default(PENDING)
  processingMessage  String?
  matchesData        Json?          // Stores detailed match fragments and sources
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("similarity_reports")
}

// ==========================================
// MÓDULO 2: LENGUA DE SEÑAS MEXICANA (LSM)
// ==========================================
model LsmSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionType String   @default("PRACTICE") // PRACTICE | EVALUATION
  totalSigns  Int      @default(0)
  accuracy    Float    @default(0.0)
  logsData    Json?    // Stores gesture predictions and timestamps
  createdAt   DateTime @default(now())

  @@map("lsm_sessions")
}

// ==========================================
// MÓDULO 3: BECAS Y POSGRADOS
// ==========================================
model StudentProfile {
  id                 String        @id @default(uuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gpa                Float
  academicLevel      AcademicLevel @default(UNDERGRADUATE)
  studyField         String
  researchInterests  String[]
  languages          String[]
  socioeconomicLevel String?
  updatedAt          DateTime      @updatedAt

  @@map("student_profiles")
}

model Scholarship {
  id              String           @id @default(uuid())
  title           String
  institution     String
  academicLevel   AcademicLevel    @default(ALL)
  country         String
  coverage        String
  deadline        DateTime
  requirements    String[]
  applicationUrl  String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]

  @@map("scholarships")
}

model Recommendation {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  matchScore    Float       // Score calculated by AI recommender
  matchedAt     DateTime    @default(now())

  @@map("recommendations")
}

// ==========================================
// MÓDULO 4: SOLICITUDES DE CAMBIO Y NOTIFICACIONES
// ==========================================
model ChangeRequest {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation("UserChangeRequests", fields: [userId], references: [id], onDelete: Cascade)
  type            ChangeRequestType
  status          ChangeRequestStatus @default(PENDING)
  requestedData   Json?               // { nombre?, apellido?, apellidoMaterno?, telefono? }
  passwordHash    String?             // Only bcrypt hash of the new password (NEVER plain text!)
  reviewedById    String?
  reviewer        User?               @relation("AdminReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  createdAt       DateTime            @default(now())
  reviewedAt      DateTime?

  @@index([userId])
  @@index([status])
  @@map("change_requests")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type              NotificationType @default(SYSTEM_ALERT)
  isRead            Boolean          @default(false)
  dismissedFromBell Boolean          @default(false)
  relatedId         String?
  expiresAt         DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([relatedId])
  @@map("notifications")
}

// ==========================================
// MÓDULO 5: BITÁCORA DE AUDITORÍA PERMANENTE
// ==========================================
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  actorName      String?
  actorRole      String?
  action         String
  module         String
  targetUserId   String?
  targetUserName String?
  entityType     String?
  entityId       String?
  description    String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor      User? @relation("AuditLogsActed", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditLogsTargeted", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([targetUserId])
  @@index([module])
  @@index([action])
  @@map("audit_logs")
}


